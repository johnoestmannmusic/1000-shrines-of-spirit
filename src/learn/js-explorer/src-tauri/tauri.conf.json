{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "js-explorer",
  "version": "0.1.0",
  "identifier": "com.john.js-explorer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "js-explorer",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "js-explorer — Tauri v2 learning app",
      "args": [
        {
          "name": "debug",
          "description": "enable debug mode"
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzRDA1QkYwMzVEN0NGOUEKUldTYXo5YzE4RnZRVXpFRzN1S0RxdGR2VzgzbmJHS3JzNVNwdmdFMHQwVGMvK2M0UnJOYnBLV2cK",
      "endpoints": []
    }
  }
}
