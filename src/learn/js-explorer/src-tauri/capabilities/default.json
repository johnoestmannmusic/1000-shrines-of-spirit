{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "clipboard-manager:default",
    "deep-link:default",
    "fs:default",
    "http:default",
    "log:default",
    "notification:default",
    "os:default",
    "process:default",
    "shell:default",
    "sql:default",
    "store:default",
    "stronghold:default",
    "upload:default",
    "websocket:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://jsonplaceholder.typicode.com/*" }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "echo-hello",
          "cmd": "echo",
          "args": ["hello from the learn page"]
        }
      ]
    }
  ]
}
